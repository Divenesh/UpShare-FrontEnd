@model upshare.Models.EnterNewPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
}

<section class="min-vh-100 login-section d-flex align-items-center">
    <div class="container-fluid py-3 py-md-5">
        <div class="row d-flex align-items-center justify-content-center">
            <div class="col-md-7 col-lg-6 col-xl-5 d-none d-md-block">
                <div class="text-center mb-3">
                    <img src="/assets/images/upShareNoBackground.png" class="img-fluid" style="max-width: 200px;" alt="UpShare Logo">
                </div>
                <div class="text-center mb-3">
                    <img src="/assets/images/loginView1.png" class="img-fluid animation-float" alt="Login illustration">
                </div>
                <div class="text-center mt-3">
                    <h3 class="text-success fw-bold">Reset Your Password</h3>
                    <p class="text-muted">Create a new secure password for your account</p>
                </div>
            </div>
            <div class="col-sm-10 col-md-5 col-lg-4 col-xl-4">
                <div class="text-center mb-4 d-md-none">
                    <img src="/assets/images/upShareNoBackground.png" class="img-fluid" style="max-width: 150px;" alt="UpShare Logo">
                </div>
                <div class="card border-0 shadow-sm rounded-4 p-3 p-sm-4">
                    <div class="card-body py-2">
                        <h3 class="text-center fw-bold mb-4">Create New Password</h3>
                        
                        <form asp-action="UpdatePassword" method="post">
                            <input type="hidden" asp-for="Token" />
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                            
                            <div class="form-floating mb-3">
                                <input asp-for="NewPassword" class="form-control" placeholder="New Password" />
                                <label asp-for="NewPassword"></label>
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>
                            
                            <div class="form-floating mb-4">
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm Password" />
                                <label asp-for="ConfirmPassword"></label>
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                            
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <span class="material-symbols-outlined align-middle me-2">lock_reset</span>
                                    Reset Password
                                </button>
                            </div>
                        </form>
                    </div>
                </div>   
            </div>     
        </div>
    </div>
</section>

<style>
  body, html {
    height: 100%;
    margin: 0;
    font-family: 'Roboto', sans-serif;
  }
  
  .login-section {
    min-height: 100vh;
    background-color: #f8f9fa;
  }
  
  .animation-float {
    animation: float 6s ease-in-out infinite;
  }
  
  @@keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-20px); }
    100% { transform: translateY(0px); }
  }
</style>