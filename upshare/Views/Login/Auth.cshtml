@{
    ViewData["Title"] = "Privacy Policy";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
}

<section class="vh-100 login-section">
  <div class="container-fluid py-5 h-100">
    <div class="row d-flex align-items-center justify-content-center h-100">
      <div class="col-md-8 col-lg-6 col-xl-6 d-none d-md-block">
        <div class="text-center mb-4">
          <img src="/assets/images/upShareNoBackground.png" class="img-fluid mb-4" style="max-width: 250px;" alt="UpShare Logo">
        </div>
        <div class="text-center mb-4">
          <img src="/assets/images/loginView1.png" class="img-fluid animation-float" alt="Login illustration">
        </div>
        <div class="text-center mt-4">
          <h3 class="text-success fw-bold">Share what you don't use</h3>
          <p class="text-muted">Join our community and start sharing today!</p>
        </div>
      </div>
<div class="col-md-6 col-lg-5 col-xl-4"> <!-- Reduced column width -->
  <div class="card border-0 shadow-sm rounded-4 p-4"> <!-- Reduced padding from p-5 to p-4 -->
    <div class="card-body py-2"> <!-- Added py-2 to reduce vertical padding -->
      <h3 class="text-center fw-bold mb-3 text-success">Welcome Back</h3> <!-- Changed h2 to h3, reduced margin -->
      <form>
        <!-- Email input -->
        <div class="form-floating mb-3"> <!-- Reduced margin-bottom -->
          <input type="email" id="emailInput" class="form-control form-control-lg border-success border-opacity-25" placeholder="Email address" />
          <label for="emailInput">Email address</label>
        </div>

        <!-- Password input -->
        <div class="form-floating mb-3"> <!-- Reduced margin-bottom -->
          <input type="password" id="passwordInput" class="form-control form-control-lg border-success border-opacity-25" placeholder="Password" />
          <label for="passwordInput">Password</label>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3"> <!-- Reduced margin-bottom -->
          <!-- Checkbox -->
          <div class="form-check">
            <input class="form-check-input border-success" type="checkbox" value="" id="rememberMe" checked />
            <label class="form-check-label small" for="rememberMe">Remember me</label> <!-- Added small class -->
          </div>
          <a href="#!" class="text-success small">Forgot password?</a> <!-- Added small class -->
        </div>

        <!-- Submit button -->
        <button type="submit" class="btn btn-success btn-lg w-100 mb-3"> <!-- Reduced margin-bottom -->
          <span class="material-symbols-outlined align-middle me-2">login</span>
          Sign in
        </button>

        <div class="text-center mb-2 small"> <!-- Reduced margin, added small class -->
          <span class="text-muted">Don't have an account?</span>
          <a href="#" class="text-success ms-2">Sign up</a>
        </div>

        <div class="divider d-flex align-items-center my-3 position-relative"> <!-- Reduced margins -->
          <hr class="flex-grow-1 border-success border-opacity-25">
          <span class="px-2 text-muted small">OR CONTINUE WITH</span> <!-- Reduced padding -->
          <hr class="flex-grow-1 border-success border-opacity-25">
        </div>

        <div class="d-flex gap-2">
          <a class="btn btn-outline-success btn-sm flex-grow-1" href="#!" role="button"> <!-- Added btn-sm -->
            <i class="fab fa-google me-2"></i>Google
          </a>
          <a class="btn btn-outline-success btn-sm flex-grow-1" href="#!" role="button"> <!-- Added btn-sm -->
            <i class="fab fa-facebook-f me-2"></i>Facebook
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
    </div>
  </div>
</section>

</bo>
<style>
  .body,html {
    height: 100%;
    margin: 0;
    overflow: hidden !important;
    font-family: 'Roboto', sans-serif;
  }
  .login-section {
    background-color: #f8f9fa;
    background-image: linear-gradient(135deg, rgba(25, 135, 84, 0.05) 0%, rgba(255, 255, 255, 0.6) 100%);
  }
  
  .card {
    border-radius: 15px;
    transition: all 0.3s ease;
  }
  
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 20px rgba(25, 135, 84, 0.1) !important;
  }
  
  .form-control:focus {
    border-color: #198754;
    box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.25);
  }
  
  .btn-success {
    padding: 0.6rem 1.5rem;
    border-radius: 8px;
    transition: all 0.3s ease;
  }
  
  .btn-success:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(25, 135, 84, 0.2);
  }
  
  .btn-outline-success {
    border-radius: 8px;
    transition: all 0.3s ease;
  }
  
  .btn-outline-success:hover {
    transform: translateY(-2px);
  }
  
  .divider {
    font-size: 0.8rem;
  }
  
  .animation-float {
    animation: float 6s ease-in-out infinite;
  }
  
  @@keyframes float {
    0% {
      transform: translatey(0px);
    }
    50% {
      transform: translatey(-20px);
    }
    100% {
      transform: translatey(0px);
    }
  }
  
  .rounded-4 {
    border-radius: 1rem;
  }
</style>