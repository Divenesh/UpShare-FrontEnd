@model upshare.Models.LoginViewModel
@{
  ViewData["Title"] = "Login";
  ViewData["HideNavbar"] = true;
  ViewData["FullWidth"] = true;
}

<section class="vh-100 login-section">
  <div class="container-fluid py-5 h-100">
    <div class="row d-flex align-items-center justify-content-center h-100">
      <div class="col-md-8 col-lg-6 col-xl-6 d-none d-md-block">
        <div class="text-center mb-4">
          <img src="/assets/images/upShareNoBackground.png" class="img-fluid mb-4" style="max-width: 250px;"
            alt="UpShare Logo">
        </div>
        <div class="text-center mb-4">
          <img src="/assets/images/loginView1.png" class="img-fluid animation-float" alt="Login illustration">
        </div>
        <div class="text-center mt-4">
          <h3 class="text-success fw-bold">Share what you don't use</h3>
          <p class="text-muted">Join our community and start sharing today!</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-5 col-xl-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
          <div class="card-body py-2">
            <h3 class="text-center fw-bold mb-3 text-success">Welcome Back</h3>
            <form asp-action="SignIn" asp-controller="Login" method="post">
              <!-- Add anti-forgery token for security -->
              @Html.AntiForgeryToken()

              <div class="form-floating mb-3">
                <input asp-for="Email" type="email" id="emailInput"
                  class="form-control form-control-lg border-success border-opacity-25" placeholder="Email address"
                  required />
                <label asp-for="Email">Email address</label>
                <span asp-validation-for="Email" class="text-danger"></span>
              </div>

              <div class="form-floating mb-3">
                <input asp-for="Password" type="password" id="passwordInput"
                  class="form-control form-control-lg border-success border-opacity-25" placeholder="Password"
                  required />
                <label asp-for="Password">Password</label>
                <span asp-validation-for="Password" class="text-danger"></span>
              </div>

              <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="form-check">
                  <input asp-for="RememberMe" class="form-check-input border-success" type="checkbox" id="rememberMe" />
                  <label class="form-check-label small" asp-for="RememberMe">Remember me</label>
                </div>
                <a href="#!" class="text-success small">Forgot password?</a>
              </div>

              <button type="submit" class="btn btn-success btn-lg w-100 mb-3">
                <span class="material-symbols-outlined align-middle me-2">login</span>
                Sign in
              </button>

              <!-- Display general validation errors -->
              <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

              <div class="text-center mb-2 small">
                <span class="text-muted">Don't have an account?</span>
                <a href="#" class="text-success ms-2">Sign up</a>
              </div>

              <div class="divider d-flex align-items-center my-3 position-relative">
                <hr class="flex-grow-1 border-success border-opacity-25">
                <span class="px-2 text-muted small">OR CONTINUE WITH</span>
                <hr class="flex-grow-1 border-success border-opacity-25">
              </div>

              <div class="d-flex gap-2">
                <a class="btn btn-outline-success btn-sm flex-grow-1" href="#!" role="button">
                  <i class="fab fa-google me-2"></i>Google
                </a>
                <a class="btn btn-outline-success btn-sm flex-grow-1" href="#!" role="button">
                  <i class="fab fa-facebook-f me-2"></i>Facebook
                </a>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  body,
  html {
    height: 100%;
    margin: 0;
    overflow: hidden !important;
    font-family: 'Roboto', sans-serif;
  }

</style>