@{
    ViewData["Title"] = "Sign Up Confirmation";
    ViewData["HideNavbar"] = true;
    ViewData["FullWidth"] = true;
}

<section class="min-vh-100 login-section">
    <div class="container-fluid py-5 h-100">
        <div class="row d-flex align-items-center justify-content-center h-100">
            <div class="col-md-8 col-lg-6 col-xl-6 d-none d-md-block">
                <div class="text-center mb-4">
                    <img src="/assets/images/upShareNoBackground.png" class="img-fluid" style="max-width: 200px;" alt="UpShare Logo">
                </div>
                <div class="text-center mb-4">
                    <img src="/assets/images/loginView1.png" class="img-fluid animation-float" alt="Login illustration">
                </div>
                <div class="text-center mt-4">
                    <h3 class="text-success fw-bold">Share what you don't use</h3>
                    <p class="text-muted">Join our community and start sharing today!</p>
                </div>
            </div>
            <div class="col-sm-10 col-md-5 col-lg-4 col-xl-4">
                <!-- Mobile-only logo -->
                <div class="text-center mb-4 d-md-none">
                    <img src="/assets/images/upShareNoBackground.png" class="img-fluid" style="max-width: 150px;" alt="UpShare Logo">
                </div>
                <div class="card border-0 shadow-sm rounded-4 p-3 p-sm-4">
                    <div class="card-body py-2">
                        <div class="text-center mb-3">
                            <span class="material-symbols-outlined text-success" style="font-size: 3.5rem;">mark_email_read</span>
                        </div>
                        <h3 class="text-center fw-bold mb-3 text-success">Email Verified!</h3>
                        <p class="text-center mb-4">
                            Thank you for confirming your email. You can now login to your account and start sharing!
                        </p>
                        <form asp-action="Auth" asp-controller="Login" method="get">
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <span class="material-symbols-outlined align-middle me-2">login</span>
                                    Back to Login
                                </button>
                            </div>
                        </form>
                    </div>
                </div>   
            </div>     
        </div>
    </div>
</section>    

<style>
  body,
  html {
    height: 100%;
    margin: 0;
    overflow: hidden !important;
    font-family: 'Roboto', sans-serif;
  }
</style>