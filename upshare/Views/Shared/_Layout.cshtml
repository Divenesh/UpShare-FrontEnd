<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - upshare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined" rel="stylesheet" />
    <link rel="stylesheet" href="~/upshare.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-light shadow-sm px-4 py-3">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">
                    <img src="/assets/images/upShareNoBackground.png" width="150" height="70"
                        class="d-inline-block align-top" alt="logo">
                </a>
                <div class="ms-auto d-flex align-items-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="me-3 text-success fw-semibold">Welcome, @User.Identity.Name!</span>
                        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                            asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                            <button type="submit" class="btn btn-outline-success">
                                <span class="material-symbols-outlined align-middle me-1"
                                    style="font-size: 18px;">logout</span>
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-outline-success me-2" asp-area="Identity" asp-page="/Account/Login">
                            <span class="material-symbols-outlined align-middle me-1" style="font-size: 18px;">login</span>
                            Login
                        </a>
                        <a class="btn btn-success" asp-area="Identity" asp-page="/Account/Register">
                            <span class="material-symbols-outlined align-middle me-1"
                                style="font-size: 18px;">person_add</span>
                            Register
                        </a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
