@model upshare.Models.User.UserDetailsModel
@using System.Security.Claims

@{
    ViewBag.Title = "Profile Page";
    ViewData["Title"] = "Profile";
}

<section class="profile-page py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-12">
                <!-- Profile Card -->
                <div class="card shadow-lg border-0 rounded-3">
                    <!-- Profile Header -->
                    <div class="profile-card-header bg-primary text-white text-center py-4">
                        <div class="profile-image-container mb-3">
                            @{
                                var profileUrl = User.FindFirst("profilePicture")?.Value;
                                var imageUrl = string.IsNullOrEmpty(profileUrl) 
                                    ? "/assets/images/default-avatar.png" 
                                    : profileUrl;
                                    
                                if (!string.IsNullOrEmpty(imageUrl) && imageUrl != "/assets/images/default-avatar.png") {
                                    imageUrl = imageUrl.Contains("?") 
                                        ? imageUrl + "&token=read&t=" + DateTime.Now.Ticks 
                                        : imageUrl + "?token=read&t=" + DateTime.Now.Ticks;
                                }
                            }
                            <div class="position-relative d-inline-block">
                                <img src="@imageUrl" 
                                     alt="Profile Picture" 
                                     class="profile-image rounded-circle border border-3 border-white shadow"
                                     onerror="this.src='/assets/images/default-avatar.png'"
                                     id="profileImagePreview">
                                <div class="edit-mode d-none">
                                    <button type="button" class="btn btn-sm btn-light rounded-circle position-absolute bottom-0 end-0" 
                                            onclick="document.getElementById('profileImageInput').click();">
                                        <span class="material-symbols-outlined" style="font-size: 16px;">camera_alt</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="view-mode">
                            <h3 class="mb-1">@(User.FindFirst("firstName")?.Value ?? "User") @(User.FindFirst("lastName")?.Value ?? "")</h3>
                            <p class="mb-0 opacity-75">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "email@example.com")</p>
                        </div>
                    </div>

                    <!-- Profile Body -->
                    <div class="card-body p-4">
                        <form id="profileForm" asp-action="SaveUserDetails" asp-controller="User" asp-route-mode="update" asp-route-source="profilePage" method="post" enctype="multipart/form-data">
                            
                            <!-- Hidden File Input - MOVED INSIDE FORM -->
                            <input type="file" id="profileImageInput" name="profilePicture" class="d-none" accept="image/*">
                            
                            <div class="row g-2">
                                <div class="col-12">
                                    <h5 class="text-muted border-bottom pb-2 mb-3">
                                        <span class="material-symbols-outlined align-middle me-2">person</span>
                                        Personal Information
                                    </h5>
                                </div>
                                
                                <div class="col-sm-6">
                                    <div class="info-item">
                                        <label class="form-label text-muted small">First Name</label>
                                        <p class="fw-medium view-mode">@(User.FindFirst("firstName")?.Value ?? "Not provided")</p>
                                        <input asp-for="firstname" class="form-control edit-mode d-none" name="firstname" 
                                               value="@(User.FindFirst("firstName")?.Value ?? "")" required>
                                        <span asp-validation-for="firstname" class="text-danger"></span>
                                    </div>
                                </div>
                                
                                <div class="col-sm-6">
                                    <div class="info-item">
                                        <label class="form-label text-muted small">Last Name</label>
                                        <p class="fw-medium view-mode">@(User.FindFirst("lastName")?.Value ?? "Not provided")</p>
                                        <input asp-for="lastname" class="form-control edit-mode d-none" name="lastname" 
                                               value="@(User.FindFirst("lastName")?.Value ?? "")" required>
                                        <span asp-validation-for="lastname" class="text-danger"></span>
                                    </div>
                                </div>
                                
                                <div class="col-12">
                                    <div class="info-item">
                                        <label class="form-label text-muted small">Email Address</label>
                                        <p class="fw-medium">@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "Not provided")</p>
                                        <div class="edit-mode d-none">
                                            <small class="text-muted">Email cannot be changed</small>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-sm-6">
                                    <div class="info-item">
                                        <label class="form-label text-muted small">Phone Number</label>
                                        <p class="fw-medium view-mode">@(User.FindFirst("phoneNumber")?.Value ?? "Not provided")</p>
                                        <input asp-for="phoneNumber" class="form-control edit-mode d-none" name="phoneNumber" 
                                               value="@(User.FindFirst("phoneNumber")?.Value ?? "")" placeholder="+1 (555) 123-4567">
                                        <span asp-validation-for="phoneNumber" class="text-danger"></span>
                                    </div>
                                </div>
                                
                                <div class="col-sm-6">
                                    <div class="info-item">
                                        <label class="form-label text-muted small">Member Since</label>
                                        <p class="fw-medium view-mode">@(User.FindFirst("dateJoined")?.Value ?? "Not available")</p>
                                        <div class="edit-mode d-none">
                                            <p class="fw-medium">@(User.FindFirst("dateJoined")?.Value ?? "Not available")</p>
                                            <small class="text-muted">Join date cannot be changed</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Address Information -->
                            <div class="row g-3 mt-3">
                                <div class="col-12">
                                    <h5 class="text-muted border-bottom pb-2 mb-3">
                                        <span class="material-symbols-outlined align-middle me-2">location_on</span>
                                        Address Information
                                    </h5>
                                </div>
                                
                                <div class="col-12">
                                    <div class="info-item">
                                        <label class="form-label text-muted small">Street Address</label>
                                        <p class="fw-medium view-mode">@(User.FindFirst("address")?.Value ?? "Not provided")</p>
                                        <input asp-for="address" class="form-control edit-mode d-none" name="address" 
                                               value="@(User.FindFirst("address")?.Value ?? "")" placeholder="123 Main Street">
                                        <span asp-validation-for="address" class="text-danger"></span>
                                    </div>
                                </div>
                                
                                <div class="col-sm-4">
                                    <div class="info-item">
                                        <label class="form-label text-muted small">City</label>
                                        <p class="fw-medium view-mode">@(User.FindFirst("city")?.Value ?? "Not provided")</p>
                                        <input asp-for="city" class="form-control edit-mode d-none" name="city" 
                                               value="@(User.FindFirst("city")?.Value ?? "")" placeholder="New York">
                                        <span asp-validation-for="city" class="text-danger"></span>
                                    </div>
                                </div>
                                
                                <div class="col-sm-4">
                                    <div class="info-item">
                                        <label class="form-label text-muted small">State</label>
                                        <p class="fw-medium view-mode">@(User.FindFirst("state")?.Value ?? "Not provided")</p>
                                        <input asp-for="state" class="form-control edit-mode d-none" name="state" 
                                               value="@(User.FindFirst("state")?.Value ?? "")" placeholder="NY">
                                        <span asp-validation-for="state" class="text-danger"></span>
                                    </div>
                                </div>
                                
                                <div class="col-sm-4">
                                    <div class="info-item">
                                        <label class="form-label text-muted small">Country</label>
                                        <p class="fw-medium view-mode">@(User.FindFirst("country")?.Value ?? "Not provided")</p>
                                        <input asp-for="country" class="form-control edit-mode d-none" name="country" 
                                               value="@(User.FindFirst("country")?.Value ?? "")" placeholder="United States">
                                        <span asp-validation-for="country" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>

                            <!-- Hidden fields -->
                            <input type="hidden" name="id" value="@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")" />
                            <input type="hidden" name="email" value="@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "")" />
                            <input type="hidden" name="dateJoined" value="@(User.FindFirst("dateJoined")?.Value ?? DateTime.Now.ToString("yyyy-MM-dd"))" />

                            <!-- Profile Actions -->
                            <div class="card-footer bg-light border-0 p-4 mt-4">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                                    <button type="button" class="btn btn-primary px-4 view-mode" id="editButton" onclick="toggleEditMode()">
                                        <span class="material-symbols-outlined align-middle me-2" style="font-size: 18px;">edit</span>
                                        Edit Profile
                                    </button>
                                    <div class="edit-mode d-none">
                                        <button type="submit" class="btn btn-success px-4 me-2" id="saveButton">
                                            <span class="material-symbols-outlined align-middle me-2" style="font-size: 18px;">save</span>
                                            Save Changes
                                        </button>
                                        <button type="button" class="btn btn-secondary px-4" onclick="cancelEdit()">
                                            <span class="material-symbols-outlined align-middle me-2" style="font-size: 18px;">cancel</span>
                                            Cancel
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>