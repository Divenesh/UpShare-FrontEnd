@model List<GetItemsFromBackend>

@{
    var categoryName = Model != null && Model.Any() ? Model.First().category : "Categories";
    ViewData["Title"] = char.ToUpper(categoryName[0]) + categoryName.Substring(1);
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="category-title text-center fw-bold">
                <span class="material-symbols-outlined category-icon me-2">
                    @(categoryName.ToLower() == "sports" ? "hiking" : 
                      categoryName.ToLower() == "clothing" ? "apparel" :
                      categoryName.ToLower() == "gadgets" ? "smartphone" : 
                      categoryName.ToLower() == "tools" ? "handyman" : "category")
                </span>
                @ViewData["Title"]
            </h1>
            <div class="heading-underline bg-success mx-auto mb-5"></div>
            <p class="lead text-center mb-5">Browse our collection of premium @(ViewData["Title"]?.ToString()?.ToLower()) available for sharing</p>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null)
        {
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 category-card shadow-sm border-0">
                        <div class="card-img-wrapper position-relative">
                            <img src="@(string.IsNullOrEmpty(item.imageUrl) ? "/assets/images/placeholder.png" : item.imageUrl)" 
                                 class="card-img-top" alt="@item.name" />
                        </div>
                        <div class="card-body">
                            <h5 class="card-title fw-bold">@item.name</h5>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="fw-bold text-success fs-5">$@item.price.ToString("0.00")</span>
                                <span class="stock-badge @(item.stock > 10 ? "text-success" : "text-danger")">
                                    <span class="material-symbols-outlined align-middle" style="font-size: 16px;">
                                        @(item.stock > 0 ? "inventory" : "inventory_2")
                                    </span>
                                    @(item.stock) in stock
                                </span>
                            </div>
                            <p class="card-text small text-muted mb-3">Added on @DateTime.Parse(item.dateAdded).ToString("MMM dd, yyyy")</p>
                            <form asp-action="ItemDetails" asp-controller="Home" method="get">
                                <input type="hidden" name="id" value="@item.id" />
                                <button type="submit" class="btn btn-outline-success w-100">View Details</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <span class="material-symbols-outlined display-1 text-muted">search_off</span>
                <h3 class="mt-3">No items found</h3>
                <p class="text-muted">We couldn't find any items in this category.</p>
                <a href="@Url.Action("Index", "Home")" class="btn btn-success mt-3">
                    <span class="material-symbols-outlined align-middle me-2">home</span>
                    Return to Home
                </a>
            </div>
        }
    </div>
</div>
