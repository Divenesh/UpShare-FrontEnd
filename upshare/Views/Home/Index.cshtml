@model List<GetDataFromBackend>

@{
    ViewData["Title"] = "Home Page";


}

<div class="header-section py-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-12 col-lg-12">
                <div class="input-group rounded shadow-sm">
                    <input type="search" class="form-control border-success" placeholder="Search for items" aria-label="Search"
                        aria-describedby="search-addon" />
                    <button class="btn btn-success" type="button" id="search-addon">
                        <span class="material-symbols-outlined align-middle">search</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>


<section class="container-fluid align-items-center category-section">
    <div class="container text-center mt-5">
        <div class="row justify-content-center mb-3">
            <div class="col-auto">
                <button type="button" class="btn btn-success category-btn mx-2">
                    <div class="row">
                        <div class="col-12">
                            <span class="material-symbols-outlined">hiking</span>
                        </div>
                        <div class="col-12">
                            <span>Sports</span>
                        </div>
                    </div>
                </button>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-success category-btn mx-2">
                    <div class="row">
                        <div class="col-12">
                            <span class="material-symbols-outlined">apparel</span>
                        </div>
                        <div class="col-12">
                            <span>Clothings</span>
                        </div>
                    </div>
                </button>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-success category-btn mx-2">
                    <div class="row">
                        <div class="col-12">
                            <span class="material-symbols-outlined">pending</span>
                        </div>
                        <div class="col-12">
                            <span>More</span>
                        </div>
                    </div>
                </button>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-success category-btn mx-2">
                    <div class="row">
                        <div class="col-12">
                            <span class="material-symbols-outlined">handyman</span>
                        </div>
                        <div class="col-12">
                            <span>Tools</span>
                        </div>
                    </div>
                </button>
            </div>
            <div class="col-auto">
                <button type="button" class="btn btn-success category-btn mx-2">
                    <div class="row">
                        <div class="col-12">
                            <span class="material-symbols-outlined">smartphone</span>
                        </div>
                        <div class="col-12">
                            <span>Gadgets</span>
                        </div>
                    </div>
                </button>
            </div>
        </div>
    </div>
</section>

<section class="container-fluid text-center mt-5">
    <div class="container mt-5">
        <div class="row">
            <div class="col-4 col-md-4 col-lg-4 col-sm-12 mt-5">
